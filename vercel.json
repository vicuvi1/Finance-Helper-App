{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --omit=dev --ignore-scripts",
  "buildCommand": "node scripts/build-web.mjs",
  "outputDirectory": "web-dist",
  "functions": {
    "api/money.mjs": {
      "maxDuration": 60,
      "includeFiles": "js/**"
    },
    "api/db.mjs": {
      "maxDuration": 30
    },
    "api/login.mjs": {
      "maxDuration": 30
    },
    "api/capture.mjs": {
      "maxDuration": 30,
      "includeFiles": "js/**"
    },
    "api/telegram.mjs": {
      "maxDuration": 30,
      "includeFiles": "js/**"
    },
    "api/cron.mjs": {
      "maxDuration": 60,
      "includeFiles": "js/**"
    },
    "api/calendar.mjs": {
      "maxDuration": 20,
      "includeFiles": "js/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron?job=morning",
      "schedule": "5 7 * * *"
    },
    {
      "path": "/api/cron?job=evening",
      "schedule": "5 19 * * *"
    }
  ]
}
